# Copie este arquivo para ".env" e ajuste os endereços para a sua máquina.
#   cp .env.example .env
#
# Celular (Expo Go) ou emulador NÃO acessam "localhost" do computador:
# use o IP da sua máquina na rede local (Windows: ipconfig | macOS/Linux: ifconfig ou ip a).
# O celular precisa estar na mesma rede Wi-Fi que o computador.
# Depois de alterar o .env, reinicie o Expo com: npx expo start --clear
#
# Atenção: variáveis EXPO_PUBLIC_ vão dentro do app e qualquer pessoa pode lê-las.
# Nunca coloque aqui senhas, tokens ou chaves secretas.

# Backend principal (Spring Boot): login, usuários, clientes, serviços, produtos, combos, funcionários
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Microsserviço de Ordens de Serviço
EXPO_PUBLIC_ORDERS_API_URL=http://192.168.0.10:8081
